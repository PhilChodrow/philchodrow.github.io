```{=html}
<% items.sort(function(a,b){return b.year - a.year + 0.1*((a.genre == "fiction") - (b.genre == "fiction" ))}) %>

<!-- filter items to only include ones where status is "read" -->
<% items = items.filter(function(item) { return item.status === "read"; }) %>

<table class="book-list">
    <tbody class="list">
    <% items.forEach(function(item) { %>
    <tr class="listing-book" <%= metadataAttrs(item) %>>
        <td class="book-year"><%= item.year %></td>
        <td class="listing-title book-title"><a href="<%- item.url %>"><i><%= item.title %></i></a></td>
        <td class="listing-author book-author">by <%= item.author %></td>
        <% if (item.categories) { %>
            <td class="listing-categories">
                <% item.categories.forEach(function(category) { %>
                    <span class="listing-category"><%= category %></span>
                <% }); %>
            </td>
        <% } %>
    <% }); %>
    </tbody>
</table>
```